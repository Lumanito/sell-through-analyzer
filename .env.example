# Copie ce fichier en .env puis colle ta clé API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : modèle Claude utilisé pour la synthèse
CLAUDE_MODEL=claude-opus-5-5

# Nombre maximum d'appels IA par jour (synthèses + imports, tous visiteurs). 0 = IA désactivée.
LIMITE_APPELS_IA_PAR_JOUR=0
